---
import styles from "./Sidebar.module.css";

const nav = [
  { label: "Work", href: "/" },
  { label: "About", href: "/about" },
  { label: "Journal", href: "/journal" },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<aside class={styles.side}>
  <canvas class={styles.fx} id="fx"></canvas>
  <div class={styles.veil}></div>
  <div class={styles.sideUi}>
    <div class={styles.brand}>
      <h1>Ann Hagan</h1>
      <span class={styles.role}>Maker · ML/AI Engineer · Pontificator</span>
    </div>

    <nav class={styles.nav}>
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class={styles.foot}>
      <div class={styles.social}>
        <a href="#">GitHub ↗</a>
        <a href="#">YouTube ↗</a>
      </div>
    </div>
  </div>
</aside>

<script>
  import { initFluid } from "../lib/fluid.js";

  const canvas = document.getElementById("fx");
  const side = canvas.closest("aside");

  initFluid(canvas, { pointerTarget: side });
</script>
